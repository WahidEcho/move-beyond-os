NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Session pooler connection string, used only by scripts/migrate.sh
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-1-eu-west-1.pooler.supabase.com:5432/postgres
# Email notifications (Resend). Leave blank to keep email disabled.
RESEND_API_KEY=
EMAIL_FROM=Move Beyond OS <os@mbeg.org>
# Public URL of the app (used in invite and email links)
NEXT_PUBLIC_SITE_URL=https://os.mbeg.org
# Protects /api/cron/alerts (Vercel Cron sends it as a Bearer token)
CRON_SECRET=
